# Optional. Without a key the full deterministic planner still works.
# Set ONE provider key server-side only. XAI takes precedence when both exist.
XAI_API_KEY=
OPENAI_API_KEY=
# Optional override; must support image inputs and JSON responses.
# Defaults: grok-4 for XAI, gpt-4o for OpenAI.
VISION_MODEL=
# Optional OpenAI-compatible HTTPS endpoint. Default depends on key selected:
# https://api.x.ai/v1 or https://api.openai.com/v1
VISION_BASE_URL=
